# مفتاح OpenAI — مطلوب لتوليد القصة والصورة
OPENAI_API_KEY=sk-...

# (اختياري) تخصيص النماذج المستخدمة
# OPENAI_TEXT_MODEL=gpt-5.1
# OPENAI_IMAGE_MODEL=gpt-image-1
# جودة الصورة: low أسرع، medium متوازنة (الافتراضي)، high أجمل لكن أبطأ
# OPENAI_IMAGE_QUALITY=medium

# —— بوابة الدفع «ميسر» ——
# المفتاح السري من لوحة ميسر ← مفاتيح الربط. ابدئي بمفتاح البيئة التجريبية
# (sk_test_...) وبعد نجاح التجربة استبدليه بمفتاح البيئة الفعلية (sk_live_...).
# بمجرد ضبط هذا المتغيّر يظهر زر الدفع في صفحة إتمام الطلب تلقائيًا.
# ⚠️ سري — لا يُكتب في الكود ولا يُرفع إلى GitHub.
# MOYASAR_SECRET_KEY=sk_test_...

# الرمز السري للإشعارات: أي نص عشوائي طويل تضعينه في لوحة ميسر ← الإشعارات
# (Webhooks) ثم هنا بنفس القيمة، ليتأكد الخادم أنّ الإشعار من ميسر فعلًا.
# MOYASAR_WEBHOOK_SECRET=

# عنوان الموقع، يُستخدم لبناء رابط العودة بعد الدفع.
# اتركيه فارغًا وسيُستنتج من الطلب تلقائيًا (يعمل على Vercel).
# NEXT_PUBLIC_SITE_URL=https://ghiras.kids

# —— حفظ الطلبات (لازم للتسليم الآلي على البريد) ——
# بدونه لا يستطيع الخادم التسليم إلّا ما دام المشتري في المتصفح بعد الدفع.
# أنشئي Vercel KV (أو Upstash Redis) واربطيه بالمشروع، فيُضبط هذان تلقائيًا:
# KV_REST_API_URL=https://...upstash.io
# KV_REST_API_TOKEN=...
# (يقبل بديلًا: UPSTASH_REDIS_REST_URL و UPSTASH_REDIS_REST_TOKEN)

# —— إرسال الخدمة على بريد المشتري (لازم للتسليم الآلي) ——
# التسليم الأساسي تنزيلٌ مباشر من صفحة الطلب، والبريد نسخة إضافية.
# بدون هذين المتغيّرين يعمل كل شيء عدا إرسال البريد، ولا يُوعَد المشتري به.
# مفتاح Resend من resend.com
# RESEND_API_KEY=re_...
# المُرسِل، ويجب أن يكون على نطاق موثّق في Resend.
# EMAIL_FROM=غِراس <no-reply@ghiras.kids>

# (اختياري) الحفظ التلقائي للقيم الجديدة في المكتبة عبر GitHub
# مفتاح GitHub بصلاحية الكتابة على المحتوى (Fine-grained: Contents = Read and write)
# GITHUB_TOKEN=github_pat_...
# اسم المستودع الذي تُحفظ فيه القيم الجديدة
# GITHUB_REPO=Cyanera/Ghiras
# الفرع (اختياري، الافتراضي main)
# GITHUB_BRANCH=main
